# Environment Configuration

# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Server Port (optional, defaults to 3000 if unset)
# Use another port (e.g. 3002) if 3000 is already in use.
PORT=3002

# Bind address (optional; 0.0.0.0 = all interfaces — best for local browsers)
# HOST=0.0.0.0
